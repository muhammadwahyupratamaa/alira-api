NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://alira:change-me@localhost:5432/alira?schema=public
POSTGRES_USER=alira
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alira
POSTGRES_PORT=5432
CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=alira-api
JWT_AUDIENCE=alira-web
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=alira_refresh
BCRYPT_ROUNDS=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
